# 복사해서 사용: cp .env.example .env  — 값을 반드시 바꾼다. .env 는 커밋하지 않는다.

# 웹 접속 포트 (http://localhost:8080)
WEB_PORT=8080

# JWT 서명 키 (32자 이상 임의 문자열). user-service 와 gateway 가 같은 값을 쓴다.
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more

# PostgreSQL 관리자 비밀번호와 서비스별 DB 계정 비밀번호
POSTGRES_PASSWORD=change-me-postgres
SERVICE_DB_PASSWORD=change-me-service

# 첫 실행 때 만들 웹사이트 admin 계정
INITIAL_ADMIN_LOGIN=admin
INITIAL_ADMIN_PASSWORD=change-me-admin

# 값이 있으면 역할 1·2·3 시험 계정(sup1, mgr1, user1)을 이 비밀번호로 만든다. 비우면 만들지 않는다.
DEMO_USERS_PASSWORD=
