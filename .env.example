# 로컬 개발·시험용 기본값. 그대로 실행할 수 있다:  cp .env.example .env   (Windows: Copy-Item .env.example .env)
# .env 가 없어도 compose.yaml 에 같은 기본값이 들어 있어 실행된다.
# 외부에 공개하는 서버에 올릴 때는 반드시 모든 값을 바꾼다. .env 는 커밋하지 않는다.
# 비밀번호는 DB 가 처음 만들어질 때 적용된다. 이미 띄운 뒤 바꾸려면 docker compose down -v 로 초기화한다.

# 웹 접속 포트 (http://localhost:8080)
WEB_PORT=8080

# JWT 서명 키 (32자 이상). user-service 와 gateway 가 같은 값을 쓴다.
JWT_SECRET=tp3-local-dev-jwt-secret-change-before-deploy

# PostgreSQL 관리자 비밀번호와 서비스별 DB 계정 비밀번호
POSTGRES_PASSWORD=tp3-postgres-local
SERVICE_DB_PASSWORD=tp3-service-local

# 첫 실행 때 만들 웹사이트 admin 계정
INITIAL_ADMIN_LOGIN=admin
INITIAL_ADMIN_PASSWORD=Admin1234!

# 역할 1·2·3 시험 계정 sup1(1 관리자)·mgr1(2 매니저)·user1(3 사용자)의 비밀번호. 비우면 만들지 않는다.
DEMO_USERS_PASSWORD=User1234!

# 시뮬레이터 모드: nav(저장 지도로 운영) / slam(지도 작성)
SIM_MODE=nav

# 시뮬레이션 로봇 모델: waffle_pi(보유 장비, 라즈베리파이 카메라) / waffle(RealSense 카메라)
# 두 모델 모두 카메라 영상을 /camera/image_raw 로 낸다.
TURTLEBOT3_MODEL=waffle_pi
LIDAR_MAX_RANGE=8.0
